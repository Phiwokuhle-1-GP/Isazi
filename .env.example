# Environment reference only. The app does not automatically load this file.
# Set via PowerShell $env:NAME="value" or Render Environment.
# SECRET_KEY: generate with python -c "import secrets; print(secrets.token_hex(32))"
# DATA_DIR: local instance folder by default; /var/data on Render
# COOKIE_SECURE=1 on HTTPS deployments (leave unset for local HTTP)

# Connected services: disabled until configured. See ECOSYSTEM_SETUP.md.
# PUBLIC_BASE_URL=https://your-real-store-domain.example
# PAYFAST_ENABLED=0
# PAYFAST_MODE=sandbox
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ALLOWED_IPS=  # Optional override: official PayFast CIDRs only
# TRUSTED_PROXY_CIDRS= # Optional: only the hosting provider's actual trusted proxy CIDRs
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=

# Unified store and dry run (V2.6.5):
# ISAZI_CLIENT_DEMO=0 (the Windows/Render launchers select this normal database)
# DEMO_PAYMENTS_ENABLED=1 enables test stock and simulated checkout on the same site.
# Test stock starts at 50 per product; real stock is untouched by new test orders.
# Customers must create/sign into an account. Owners cannot purchase.
# Set DEMO_PAYMENTS_ENABLED=0 after the dry run; test order history remains saved.
# Windows: START_WINDOWS.ps1 -LivePayments. No real gateway is configured by switching.
